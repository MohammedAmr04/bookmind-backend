// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password_hash    String
  display_name     String?
  theme            String         @default("light")
  email_verified   Boolean        @default(false)
  created_at       DateTime       @default(now())
  updated_at       DateTime       

  // Relations
  plan_id            String           @default("free")
  subscription_plan  SubscriptionPlan @relation(fields: [plan_id], references: [id])  
  bookmarks        UserBookmark[]
  tags             Tag[]
  projects         Project[]
  study_plans      StudyPlan[]
  quotas           Quota[]

  @@map("users")
}

model GlobalContent {
  id            String   @id @default(uuid())
  url           String   @unique
  title         String?
  content       String   @db.Text
  platform      String   // "Twitter", "Reddit", etc.
  external_id   String   @unique // ID from json 
  // embedding     Unsupported("vector")? // for semantic search
  media         Json?    // photos or videos
  raw_metadata  Json?    // extra data 
  ai_summary    String?  @db.Text
  created_at    DateTime @default(now())

  // Relations
  user_bookmarks UserBookmark[]

  @@map("global_content")
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique // "Free", "Pro", "Enterprise"
  description     String?
  monthly_price   Decimal  @default(0.0)
  max_bookmarks   Int      @default(100)  
  ai_summaries_limit Int   @default(10)   
  can_export_json Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime 

  users           User[]

  @@map("subscription_plans")
}
model UserBookmark {
  id                String   @id @default(uuid())
  user_id           String
  global_content_id String
  category          String?  
  priority          String?
  is_favourite      Boolean  @default(false)
  is_completed      Boolean  @default(false)
  read_later_due_date DateTime?
  read_later_progress Int    @default(0)
  remind_me         DateTime?
  saved_at          DateTime @default(now())

  // Relations
  user           User           @relation(fields: [user_id], references: [id])
  global_content GlobalContent  @relation(fields: [global_content_id], references: [id])
  notes          BookmarkNote[]
  tags           BookmarkTag[]

  @@map("user_bookmarks")
}

model BookmarkNote {
  id               String   @id @default(uuid())
  user_bookmark_id String
  note_text        String?  @db.Text
  summary          String?  @db.Text 
  why_saved        String?  @db.Text
  key_points       Json?    
  created_at       DateTime @default(now())
  updated_at       DateTime 

  bookmark UserBookmark @relation(fields: [user_bookmark_id], references: [id])

  @@map("bookmark_notes")
}

model Tag {
  id      String @id @default(uuid())
  user_id String?
  name    String
  type    String @default("manual") // AI or Manual

  user      User?          @relation(fields: [user_id], references: [id])
  bookmarks BookmarkTag[]

  @@map("tags")
}

model BookmarkTag {
  user_bookmark_id String
  tag_id           String

  bookmark UserBookmark @relation(fields: [user_bookmark_id], references: [id])
  tag      Tag          @relation(fields: [tag_id], references: [id])

  @@id([user_bookmark_id, tag_id])
  @@map("bookmark_tags")
}

model Project {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime 

  user  User   @relation(fields: [user_id], references: [id])
  tasks Task[]

  @@map("projects")
}

model Task {
  id          String   @id @default(uuid())
  project_id  String
  title       String
  description String?  @db.Text
  priority    String?
  due_date    DateTime?
  is_completed Boolean @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime 

  project Project @relation(fields: [project_id], references: [id])

  @@map("tasks")
}

model StudyPlan {
  id           String   @id @default(uuid())
  user_id      String
  plan_data    Json
  generated_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("ai_study_plans")
}

model Quota {
  id          String   @id @default(uuid())
  user_id     String
  record_date DateTime @default(now())
  count       Int      @default(0)

  user User @relation(fields: [user_id], references: [id])

  @@map("ai_quota")
}